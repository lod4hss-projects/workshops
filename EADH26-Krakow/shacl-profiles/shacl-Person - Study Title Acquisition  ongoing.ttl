sdh-shacl:sdh-sls_C8_Shape a sh:NodeShape ;
        sh:targetClass sdh-sls:C8 ;
        sh:name "Study title";
    
        sh:property [
            sh:path sdh-short:P9;
            sh:name "Standard Label";
            sh:datatype xsd:string;
