  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nPREFIX sh: <http://www.w3.org/ns/shacl#>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\nCONSTRUCT {\n  # Create a NodeShape for every class found\n  ?shapeUri a sh:NodeShape ;\n            sh:targetClass ?class ;\n            sh:name ?classLabel ;\n  \n    # Create PropertyShapes for properties used by instances of that class\n            sh:property [\n                    # rdf:type sh:PropertyShape ;\n                    sh:path ?prop ;\n                    sh:name ?propLabel;\n                    #sh:minCount 1 ; # Assumes if it exists in data, it might be required (adjust logic as needed)\n                    ?predicate ?predicateObject;\n            ].\n}\nwhere {\n            {SELECT distinct ?class ?classLabel ?prop ?propLabel ?predicate ?predicateObject ?shapeUri\n            WHERE {\n                graph <https://github.com/lod4hss-projects/workshops/blob/main/DH25-Lisbon/graphs/idref-sudoc.md>\n            \n                    {\n                        # Find instances and their classes\n                    ?instance a ?class .\n                   BIND(IRI(CONCAT(STR(?class),\"-shape\")) AS ?shapeUri)\n                    \n                    # FILTER (?class != owl:Class) # Exclude meta-classes\n                    \n                    # Find properties used by these instances\n                    ?instance ?prop ?value .\n                    FILTER (?prop != rdf:type) # Exclude rdf:type from property shapes\n                    \n                    OPTIONAL{?value a ?valueClass.}\n                    \n\n                    \n                    # Generate labels\n                    BIND(COALESCE(REPLACE(STR(?class), \"^.*/\", \"\"), 'no label') AS ?classLabel)\n                    BIND(COALESCE(REPLACE(STR(?prop), \"^.*/\", \"\"), 'no label')  AS ?propLabel)\n\n                    # Determine node kind based on value type\n                    BIND(\n                        IF(isIRI(?value), sh:class, sh:datatype) AS ?predicate\n                    )\n                    BIND(\n                        IF(isIRI(?value), ?valueClass, 'xsd:string') AS ?predicateObject\n                            )\n                    }\n            }\n            #group by ?class ?classLabel ?prop ?propLabel ?predicate \n            order by ?class\n            }\n    \n}\nlimit 100",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nPREFIX sh: <http://www.w3.org/ns/shacl#>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\nINSERT { \n    graph <https://github.com/lod4hss-projects/workshops/blob/main/DH25-Lisbon/graphs/idref-sudoc-shacl.md> {\n   # Create a NodeShape for every class found\n  ?shapeUri a sh:NodeShape ;\n            sh:targetClass ?class ;\n            sh:name ?classLabel ;\n  \n    # Create PropertyShapes for properties used by instances of that class\n            sh:property [\n                    # rdf:type sh:PropertyShape ;\n                    sh:path ?prop ;\n                    sh:name ?propLabel;\n                    #sh:minCount 1 ; # Assumes if it exists in data, it might be required (adjust logic as needed)\n                    ?predicate ?predicateObject;\n            ].\n    }\n}\nwhere {\n            {SELECT distinct ?class ?classLabel ?prop ?propLabel ?predicate ?predicateObject ?shapeUri\n            WHERE {\n                graph <https://github.com/lod4hss-projects/workshops/blob/main/DH25-Lisbon/graphs/idref-sudoc.md>\n            \n                    {\n                        # Find instances and their classes\n                    ?instance a ?class .\n                   BIND(IRI(CONCAT(STR(?class),\"-shape\")) AS ?shapeUri)\n                    \n                    # FILTER (?class != owl:Class) # Exclude meta-classes\n                    \n                    # Find properties used by these instances\n                    ?instance ?prop ?value .\n                    FILTER (?prop != rdf:type) # Exclude rdf:type from property shapes\n                    \n                    OPTIONAL{?value a ?valueClass.}\n                    \n\n                    \n                    # Generate labels\n                    BIND(COALESCE(REPLACE(STR(?class), \"^.*/\", \"\"), 'no label') AS ?classLabel)\n                    BIND(COALESCE(REPLACE(STR(?prop), \"^.*/\", \"\"), 'no label')  AS ?propLabel)\n\n                    # Determine node kind based on value type\n                    BIND(\n                        IF(isIRI(?value), sh:class, sh:datatype) AS ?predicate\n                    )\n                    BIND(\n                        IF(isIRI(?value), ?valueClass, 'xsd:string') AS ?predicateObject\n                            )\n                    }\n            }\n            #group by ?class ?classLabel ?prop ?propLabel ?predicate \n            order by ?class\n            }\n    \n}",
    "metadata": {}
  },
