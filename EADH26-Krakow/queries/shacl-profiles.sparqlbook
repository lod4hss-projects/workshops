  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX owl: <http://www.w3.org/2002/07/owl#>\nconstruct {?p a owl:Object}\nwhere {\n    select distinct ?p\nwhere {graph <https://github.com/lod4hss-projects/workshops/blob/main/DH25-Lisbon/graphs/idref-sudoc.md>\n {?s ?p ?o.}\n }\n}\n\n",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nPREFIX sh: <http://www.w3.org/ns/shacl#>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\n# SELECT (COUNT(*) AS ?num)\nselect distinct *\nwhere {\n            {SELECT distinct ?class ?classLabel ?prop ?propLabel ?predicate ?shapeUri\n            ?object\n#            (max(?object) as ?predObject) \n   #         (IRI(CONCAT(\"http://shacl-sudoc.org/shapes#\", STR(UUID()))) AS ?shapeUri)\n            WHERE {\n                graph <https://github.com/lod4hss-projects/workshops/blob/main/DH25-Lisbon/graphs/idref-sudoc.md>\n            \n                    {\n                        # Find instances and their classes\n                    ?instance a ?class .\n                   #BIND(IRI(CONCAT(\"http://example.org/shapes#\", ENCODE_FOR_URI(STR(?class)))) AS ?shapeUri)\n                   #BIND(IRI(CONCAT(\"http://example.org/shapes#\", STR(?class))) AS ?shapeUri)\n                   BIND(IRI(CONCAT(STR(?class),\"-shape\")) AS ?shapeUri)\n                    \n                    # FILTER (?class != owl:Class) # Exclude meta-classes\n                    \n                    # Find properties used by these instances\n                    ?instance ?prop ?value .\n                    FILTER (?prop != rdf:type) # Exclude rdf:type from property shapes\n                    \n                    OPTIONAL{?value a ?valueClass.}\n                    \n\n                    \n                    # Generate labels\n                    BIND(COALESCE(REPLACE(STR(?class), \"^.*/\", \"\"), 'no label') AS ?classLabel)\n                    BIND(COALESCE(REPLACE(STR(?prop), \"^.*/\", \"\"), 'no label')  AS ?propLabel)\n\n                    # Determine node kind based on value type\n                    BIND(\n                        IF(isIRI(?value), sh:class, sh:datatype) AS ?predicate\n                    )\n                    BIND(\n                                IF(isIRI(?value), ?valueClass, 'xsd:string') AS ?object\n                            )\n                    }\n            }\n            #group by ?class ?classLabel ?prop ?propLabel ?predicate \n            order by ?class ?prop\n            }\n    \n}\nlimit 100",
    "metadata": {}
  },
