    "value": "select *\nWHERE {\n    graph <https://github.com/lod4hss-projects/workshops/blob/main/DH25-Lisbon/graphs/idref-sudoc.md>\n  \n        {?s <http://purl.org/dc/terms/subject> ?o.\n        optional{?o a ?oClass}\n        minus {?o a ?oClass}}\n}\nlimit 10",
